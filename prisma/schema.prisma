// ============================================================
// ART Collection Client Portal — Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPERADMIN
  ADMIN
  CLIENT
  CLIENT_REPRESENTATIVE
}

enum EnquiryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RepresentativeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoanStatus {
  ON_LOAN
  RETURNED
  OVERDUE
}

enum ResourceType {
  ARTICLE
  AUCTION
  ANALYTICS
  VIDEO
  IFRAME
  WIDGET
}

// ============================================================
// USER  (single table, self-relation for CLIENT → REPRESENTATIVE)
// ============================================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String?
  role          UserRole @default(CLIENT)

  // Self-relation: CLIENT_REPRESENTATIVE has parentId pointing to their CLIENT
  parentId      String?
  parent        User?    @relation("ClientRepresentatives", fields: [parentId], references: [id], onDelete: SetNull)
  representatives User[] @relation("ClientRepresentatives")

  isVerified    Boolean  @default(false)
  twoFactorAuth Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  otps                   OTP[]
  enquiries              Enquiry[]
  assignedEnquiries      Enquiry[]               @relation("AssignedEnquiries")
  artworkAccess          ArtWorkAccess[]
  representativeRequests RepresentativeRequest[] @relation("ClientRequests")
  reviewedRequests       RepresentativeRequest[] @relation("ReviewedRequests")
  shareLinks             ArtworkShareLink[] @relation("CreatedShareLinks")
  receivedShareLinks     ArtworkShareLink[] @relation("SharedWithRecipients")
  favoriteArtworks       FavoriteArtwork[]
  shortlistedArtworks    ShortlistedArtwork[]
  createdCollections     Collection[]         @relation("CreatedCollections")
  createdResources       ExternalResource[]   @relation("CreatedResources")
}

// ============================================================
// OTP
// ============================================================

model OTP {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================
// ARTWORK
// ============================================================

model ArtWork {
  id         String   @id @default(uuid())
  title      String
  artist     String
  year       DateTime
  medium     String
  dimensions String?
  provenance String?
  location   String?
  period     String?
  pictures   String[]
  price      Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Access control junction
  userAccess ArtWorkAccess[]
  enquiries  Enquiry[]
  shareLinks ArtworkShareLink[]
  favoritedBy FavoriteArtwork[]
  shortlistedBy ShortlistedArtwork[]
  loans       ArtworkLoan[]
  externalResources ExternalResource[]
  collections   Collection[]

  @@index([artist])
  @@index([medium])
  @@index([period])
  @@index([location])
  @@index([provenance])
}

model RelatedWorkSettings {
  id             String   @id @default(uuid())

  matchArtist    Boolean  @default(true)
  matchMedium    Boolean  @default(true)
  matchPeriod    Boolean  @default(false)
  matchLocation  Boolean  @default(false)
  matchProvenance Boolean @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ArtworkVisibilitySettings {
  id             String   @id @default("global-visibility")

  showTitle      Boolean  @default(true)
  showArtist     Boolean  @default(true)
  showYear       Boolean  @default(true)
  showMedium     Boolean  @default(true)
  showDimensions Boolean  @default(true)
  showProvenance Boolean  @default(true)
  showLocation   Boolean  @default(true)
  showPeriod     Boolean  @default(true)
  showPrice      Boolean  @default(true)
  showPictures   Boolean  @default(true)

  updatedAt      DateTime @updatedAt
}

// ============================================================
// ARTWORK ACCESS  (many-to-many: User ↔ ArtWork)
// Records which user has access to which artwork, and who granted it.
// ============================================================

model ArtWorkAccess {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artworkId String
  artwork   ArtWork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  grantedBy String?  // ID of the admin/client who granted this access

  createdAt DateTime @default(now())

  @@unique([userId, artworkId])
  @@index([userId])
  @@index([artworkId])
}

// ============================================================
// SHORTLISTED ARTWORK
// ============================================================

model ShortlistedArtwork {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artworkId String
  artwork   ArtWork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, artworkId])
  @@index([userId])
  @@index([artworkId])
}

// ============================================================
// ENQUIRY
// ============================================================

model Enquiry {
  id         String        @id @default(uuid())
  artworkId  String
  artwork    ArtWork       @relation(fields: [artworkId], references: [id])
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  message    String
  status     EnquiryStatus @default(PENDING)
  assignedTo String?
  assignee   User?         @relation("AssignedEnquiries", fields: [assignedTo], references: [id])

  history   EnquiryHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ENQUIRY HISTORY  (audit trail)
// ============================================================

model EnquiryHistory {
  id        String   @id @default(uuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  action    String
  doneBy    String   // Name or email of the actor

  createdAt DateTime @default(now())
}

// ============================================================
// REPRESENTATIVE REQUEST
// CLIENT submits → ADMIN/SUPERADMIN approves/rejects
// ============================================================

model RepresentativeRequest {
  id             String                      @id @default(uuid())
  clientId       String
  client         User                        @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)
  requestedName  String
  requestedEmail String
  status         RepresentativeRequestStatus @default(PENDING)
  reviewedBy     String?
  reviewer       User?                       @relation("ReviewedRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

// ============================================================
// ARTWORK SHARE LINK
// ============================================================

model ArtworkShareLink {
  id          String    @id @default(uuid())
  token       String    @unique
  createdById String
  createdBy   User      @relation("CreatedShareLinks", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  // Many-to-many relation directly with ArtWork
  artworks    ArtWork[]
  
  // Many-to-many relation for recipients
  sharedWith  User[]    @relation("SharedWithRecipients")
}

// ============================================================
// FAVORITE ARTWORK
// ============================================================

model FavoriteArtwork {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artworkId String
  artwork   ArtWork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, artworkId])
  @@index([userId])
  @@index([artworkId])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  method     String
  endpoint   String
  payload    Json?
  ipAddress  String?
  statusCode Int?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// ARTWORK LOAN (External Display)
// ============================================================

model ArtworkLoan {
  id              String     @id @default(uuid())
  artworkId       String
  artwork         ArtWork    @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  
  borrowerName    String
  borrowerContact String?
  location        String     // Where it is displayed externally
  
  loanDate        DateTime   @default(now())
  dueDate         DateTime
  returnDate      DateTime?  // Actual return date
  
  status          LoanStatus @default(ON_LOAN)
  notes           String?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([artworkId])
  @@index([status])
  @@index([dueDate])
}

// ============================================================
// COLLECTION
// ============================================================

model Collection {
  id          String   @id @default(uuid())
  name        String
  description String?
  
  createdById String
  createdBy   User     @relation("CreatedCollections", fields: [createdById], references: [id])
  
  artworks    ArtWork[]
  resources   ExternalResource[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// EXTERNAL MARKET RESOURCE
// ============================================================

model ExternalResource {
  id           String       @id @default(uuid())
  title        String
  description  String?
  url          String
  type         ResourceType
  thumbnail    String?
  
  isActive     Boolean      @default(true)
  
  artworkId    String?
  artwork      ArtWork?     @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  
  collectionId String?
  collection   Collection?  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  createdById  String
  createdBy    User         @relation("CreatedResources", fields: [createdById], references: [id])

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([artworkId])
  @@index([collectionId])
  @@index([type])
}