// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String?
  roleId        String?
  role          Role?    @relation(fields: [roleId], references: [id])
  isVerified    Boolean  @default(false)
  twoFactorAuth Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  otps              OTP[]
  enquiries         Enquiry[]
  assignedEnquiries Enquiry[] @relation("AssignedEnquiries")
}


model Permission {
  id        String           @id @default(uuid())
  name      String           @unique // e.g., READ_ARTWORK
  action    String           // e.g., READ
  resource  String           // e.g., ARTWORK
  roles     RolePermission[]
  createdAt DateTime         @default(now())
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}



model OTP {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ArtWork{
  id String  @id @default(uuid())
  artist String
  title String
  year DateTime
  medium String
  dimensions String
  provenance String
  location String
  Pictures String[]
  price Float
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt
  enquiries Enquiry[]
}

enum EnquiryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Enquiry {
  id         String        @id @default(uuid())
  artworkId  String
  artwork    ArtWork       @relation(fields: [artworkId], references: [id])
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  message    String
  status     EnquiryStatus @default(PENDING)
  assignedTo String?
  assignee   User?         @relation("AssignedEnquiries", fields: [assignedTo], references: [id])
  history    EnquiryHistory[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model EnquiryHistory {
  id        String   @id @default(uuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  action    String   // e.g., "Status changed to RESOLVED"
  doneBy    String   // Name or ID of the person who made the change
  createdAt DateTime @default(now())
}